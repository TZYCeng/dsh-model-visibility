{
  "name": "@tzyc/dsh-model-visibility",
  "version": "1.16.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "DSH model visibility, field-level capability evidence, guarded reasoning-level writes, usage, and opt-in local diagnostics.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "client-src",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "screenshots.json",
    "HANDOVER.md",
    "docs",
    "!code_engineer"
  ],
  "scripts": {
    "test": "node --import ./test/setup.mjs --test test/*.test.mjs",
    "build": "node scripts/build-client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TZYCeng/dsh-model-visibility.git"
  },
  "homepage": "https://github.com/TZYCeng/dsh-model-visibility#readme",
  "bugs": {
    "url": "https://github.com/TZYCeng/dsh-model-visibility/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "model-visibility",
    "model-selector"
  ],
  "author": "TZYCeng",
  "license": "MIT"
}
